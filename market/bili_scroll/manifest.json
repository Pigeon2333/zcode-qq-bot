{
  "name": "bili_scroll",
  "version": "1.3.0",
  "title": "B 站刷视频",
  "description": "机器人用自己的 B 站账号扫码登录后，按周期以人设与记忆兴趣刷视频：见闻注入聊天、好物按人设口吻分享（渠道/目标可配）；消息里的 BV 号/链接自动带视频信息进对话。Cookie 只存本机。",
  "default_enabled": false,
  "settings": [
    {
      "key": "window_min",
      "type": "number",
      "label": "刷视频周期（分钟，一个窗口评估一次）",
      "default": 180,
      "min": 30,
      "max": 1440
    },
    {
      "key": "max_bili_dm",
      "type": "number",
      "label": "B 站私信每轮最多发几个（0=该渠道不发；上限不是强制——她按人设口味自主挑 0 到上限个，优先最感兴趣的，不凑数）",
      "default": 2,
      "min": 0,
      "max": 10
    },
    {
      "key": "max_qq_private",
      "type": "number",
      "label": "QQ 私聊每轮最多发几个（0=该渠道不发；规则同上）",
      "default": 2,
      "min": 0,
      "max": 10
    },
    {
      "key": "max_qq_group",
      "type": "number",
      "label": "QQ 群聊每轮最多发几个（0=该渠道不发；规则同上）",
      "default": 2,
      "min": 0,
      "max": 10
    },
    {
      "key": "keywords",
      "type": "text",
      "label": "兴趣关键词（逗号分隔；无论是否填写，都会叠加按人设与记忆生成的兴趣一起检索；主人说过喜欢/不喜欢什么视频也会被记住并生效）",
      "default": ""
    },
    {
      "key": "link_card_enabled",
      "type": "toggle",
      "label": "识别消息里的 B 站视频链接/BV 号，自动带视频信息（标题/UP/播放量等）进对话",
      "default": true
    },
    {
      "key": "hot_inject_enabled",
      "type": "toggle",
      "label": "聊到“B站热门/什么火”时自动带上当前热门榜单（只读公开数据）",
      "default": false
    }
  ],
  "page": {
    "js": "biliPageHtml",
    "data": "/api/bili/status"
  },
  "category": "娱乐"
}
